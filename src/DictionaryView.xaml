<UserControl x:Class="Civ6EnglishDemo.DictionaryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <DataTemplate x:Key="SenseTemplate">
   <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,10,0,14">
    <StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="#14766B" Margin="0,0,0,5"/><TextBlock Text="{Binding Meaning}" TextWrapping="Wrap" FontSize="16" LineHeight="25"/></StackPanel>
   </Border>
  </DataTemplate>
  <DataTemplate x:Key="EnglishSenseTemplate">
   <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,10,0,14">
    <StackPanel>
     <DockPanel LastChildFill="True"><Button DockPanel.Dock="Right" Content="朗读" Tag="{Binding Meaning}" Click="ReadDefinition_Click" Padding="8,3" Margin="8,0,0,4" ToolTip="朗读这条英文解释"/><TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="#14766B" Margin="0,0,0,5"/></DockPanel>
     <TextBlock Text="{Binding Meaning}" TextWrapping="Wrap" FontSize="16" LineHeight="25"/>
    </StackPanel>
   </Border>
  </DataTemplate>
 </UserControl.Resources>
 <ScrollViewer x:Name="ResultsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="0,0,12,0">
   <Border Background="#EDF5F3" CornerRadius="8" Padding="20" Margin="0,0,0,18">
    <StackPanel>
     <TextBlock x:Name="Heading" Text="选择一个单词，开始查词" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock x:Name="Syllables" FontSize="23" FontWeight="SemiBold" Foreground="#14766B" Margin="0,7,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
     <TextBlock x:Name="Phonetic" FontSize="18" Foreground="#55716D" Margin="0,8,0,0"/>
     <WrapPanel Margin="0,12,0,0">
      <Button x:Name="PronounceButton" Content="▶ 发音" Click="Pronounce_Click" IsEnabled="False" Background="#D4EAE4" ToolTip="使用 Windows 英文语音朗读查询的词或短语"/>
      <Button x:Name="RootPronounceButton" Content="原形发音" Click="RootPronounce_Click" Visibility="Collapsed"/>
      <Button x:Name="StopSpeechButton" Content="停止" Click="StopSpeech_Click" IsEnabled="False"/>
      <CheckBox x:Name="SlowSpeech" Content="慢速" VerticalAlignment="Center" Margin="6,0,0,8"/>
     </WrapPanel>
     <TextBlock x:Name="SpeechStatus" Text="点击发音即可朗读，无需联网或 API 密钥。" Foreground="#55716D" TextWrapping="Wrap"/>
     <TextBlock x:Name="PartsOfSpeech" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="#14766B" TextWrapping="Wrap"/>
     <TextBlock x:Name="SourceInfo" Text="词性、中英文释义、词形变化将在这里显示。" Foreground="#64748B" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
   <TextBlock x:Name="Notice" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,12"/>
   <Grid x:Name="MeaningsGrid">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="中文释义" FontSize="19" FontWeight="SemiBold"/><ItemsControl x:Name="Chinese" ItemTemplate="{StaticResource SenseTemplate}"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="English definitions" FontSize="19" FontWeight="SemiBold"/><ItemsControl x:Name="English" ItemTemplate="{StaticResource EnglishSenseTemplate}"/></StackPanel>
   </Grid>
   <Border x:Name="FormsBox" Background="#F3F5F8" CornerRadius="6" Padding="14" Margin="0,18,0,12">
    <StackPanel><TextBlock Text="词形变化" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock x:Name="Forms" TextWrapping="Wrap" LineHeight="25"/></StackPanel>
   </Border>
   <Border Background="#F6F8FC" BorderBrush="#DCE5F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
    <StackPanel><TextBlock Text="在线翻译补充" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock x:Name="OnlineText" Text="可在上方开启联网补充；本地释义无需密钥。" TextWrapping="Wrap" FontSize="16" LineHeight="25"/></StackPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
